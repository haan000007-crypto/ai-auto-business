{
  "name": "ai-auto-business",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered business automation platform",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ai-auto-business/database db:generate",
    "db:migrate": "pnpm --filter @ai-auto-business/database db:migrate"
  }
}
